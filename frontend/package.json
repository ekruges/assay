{
  "name": "assay-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare-data": "node scripts/prepare-data.mjs",
    "predev": "npm run prepare-data",
    "dev": "vite",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test:unit": "node --test src/lib/assay.test.ts",
    "test:contract": "node --test src/lib/contract.test.ts",
    "test": "npm run test:unit && npm run test:contract",
    "prebuild": "npm run prepare-data",
    "build": "vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/node": "25.0.3",
    "svelte": "5.56.10",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.2.2"
  }
}
